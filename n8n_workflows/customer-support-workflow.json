    "Check Escalations Schedule": {
      "main": [
        [
          {
            "node": "Get Open High Priority Tickets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Open High Priority Tickets": {
      "main": [
        [
          {
            "node": "Has Old High Priority Tickets?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Old High Priority Tickets?": {
      "main": [
        [
          {
            "node": "Escalate to Manager",
            "type": "main",
            "index": 0
          }
